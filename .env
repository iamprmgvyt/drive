# Environment example

# Vercel control plane
DATABASE_URL=postgres://postgres:postgres@postgres:5432/drive
NEXTAUTH_SECRET=replace-with-secure-random
JWT_SECRET=replace-with-secure-random
VERCEL_VPS_SERVICE_KEY_ID=service-key-id
VERCEL_VPS_SERVICE_SECRET=service-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# VPS
VPS_MASTER_KEY_PATH=/etc/drive/master.key
VPS_STORAGE_DIR=/var/lib/drive/objects
VPS_SERVICE_PORT=8443

# Redis (optional, for nonce cache/session)
REDIS_URL=redis://redis:6379
